const app=document.getElementById('app'),toast=document.getElementById('toast');
const state={me:null,view:'home',exam:null,questions:[],attemptId:null,timer:null,answers:{},submitting:false,expired:false,adminTab:'overview',editingExam:null,editingQuestion:null};
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function showToast(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2600)}
async function api(path,opts={}){const r=await fetch(path,{credentials:'same-origin',headers:{'content-type':'application/json',...(opts.headers||{})},...opts});let d=null;try{d=await r.json()}catch{}if(!r.ok)throw new Error(d?.error||'Request failed');return d}
function fmtDate(v){return v?new Date(v.replace(' ','T')+'Z').toLocaleString():''}
function layout(content,opts={}){return `<div class="shell"><header class="topbar"><div class="brand"><div class="brand-mark">AE</div><div>Ahmed Finance<small>EXAM PLATFORM</small></div></div><div class="top-actions">${state.me?.user?`<button class="btn ghost" onclick="go('dashboard')">Dashboard</button><button class="btn" onclick="logout()">Logout</button>`:state.me?.admin?`<button class="btn ghost" onclick="go('admin')">Admin</button><button class="btn" onclick="logout()">Logout</button>`:`<button class="btn ghost" onclick="go('login')">Student Login</button><button class="btn orange" onclick="go('register')">Register</button>`}</div></header>${content}<footer class="footer">Numbers tell a story. I analyze it. · Ahmed Elsheshtawy</footer></div>`}
async function boot(){try{state.me=await api('/api/auth/me')}catch{}render()}
function render(){if(state.view==='admin-login')return renderAdminLogin();if(state.view==='login')return renderLogin();if(state.view==='register')return renderRegister();if(state.view==='dashboard'&&state.me?.user)return renderDashboard();if(state.view==='exam'&&state.me?.user)return renderExam();if(state.view==='result')return renderResult(state.lastResult);if(state.view==='admin'&&state.me?.admin)return renderAdmin();state.view='home';renderHome()}
function renderHome(){app.innerHTML=layout(`<main class="page"><section class="hero"><div class="hero-card"><div class="eyebrow">Finance · Assessment · Development</div><h1>Turn knowledge into measurable performance.</h1><p>A focused exam platform for finance learners. Register, receive your Student ID, take active assessments, and track your results in one calm workspace.</p><div class="actions"><button class="btn orange" onclick="go('register')">Create Student Account ↗</button><button class="btn ghost" onclick="go('login')">Student Login</button><button class="btn ghost" onclick="go('admin-login')">Admin</button></div></div><div class="hero-card hero-side"><div><div class="eyebrow">Platform</div><h3>Built for finance education.</h3></div><div><div class="statline"><span>Student ID</span><span>Generated securely</span></div><div class="statline"><span>Grading</span><span>Automatic</span></div><div class="statline"><span>Sessions</span><span>Server-side</span></div><div class="statline"><span>Database</span><span>Cloudflare D1</span></div></div></div></section><section class="card"><div class="section-head"><div><div class="eyebrow">Secure by design</div><h2>One place for exams and results.</h2></div></div><div class="grid grid-3"><div><b>Student identity</b><p class="muted">Every learner has a unique Student ID and secure account.</p></div><div><b>Timed assessments</b><p class="muted">The timer is enforced by the server, not only by the browser.</p></div><div><b>Private answers</b><p class="muted">Correct answers remain server-side until grading.</p></div></div></section></main>`)}
function renderAdminLogin(){app.innerHTML=layout(`<main class="page"><div class="center"><div class="card"><div class="eyebrow">Administration</div><h1>Control center.</h1><p class="muted">Authorized administrators only.</p><form class="form" onsubmit="adminLogin(event)"><div class="field"><label>Username</label><input name="username" required autocomplete="username"></div><div class="field"><label>Password</label><input name="password" type="password" required autocomplete="current-password"></div><button class="btn orange">Admin Login</button></form><p class="small-text muted">Student? <span class="link" onclick="go('login')">Student login</span></p></div></div></main>`)}
async function adminLogin(e){e.preventDefault();const f=new FormData(e.target);try{await api('/api/admin/login',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});state.me=await api('/api/auth/me');state.view='admin';render()}catch(x){showToast(x.message)}}
function renderLogin(){app.innerHTML=layout(`<main class="page"><div class="center"><div class="card"><div class="eyebrow">Student access</div><h1>Welcome back.</h1><p class="muted">Use your Student ID or email and password.</p><form class="form" onsubmit="studentLogin(event)"><div class="field"><label>Student ID / Email</label><input name="identifier" required autocomplete="username"></div><div class="field"><label>Password</label><input name="password" type="password" required autocomplete="current-password"></div><button class="btn orange">Login</button></form><p class="small-text muted">No account? <span class="link" onclick="go('register')">Register here</span></p></div></div></main>`)}
function renderRegister(){app.innerHTML=layout(`<main class="page"><div class="center"><div class="card"><div class="eyebrow">New student</div><h1>Create your account.</h1><p class="muted">Your Student ID is generated automatically. You will see it immediately after registration.</p><form class="form" onsubmit="studentRegister(event)"><div class="field"><label>Full name</label><input name="fullName" required maxlength="120"></div><div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Password</label><input name="password" type="password" minlength="8" maxlength="128" required></div><button class="btn orange">Register & Get Student ID</button></form><p class="small-text muted">Already registered? <span class="link" onclick="go('login')">Login</span></p></div></div></main>`)}
async function studentLogin(e){e.preventDefault();const f=new FormData(e.target);try{await api('/api/auth/login',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});state.me=await api('/api/auth/me');showToast('Login successful');go('dashboard')}catch(x){showToast(x.message)}}
async function studentRegister(e){e.preventDefault();const f=new FormData(e.target);try{const d=await api('/api/auth/register',{method:'POST',body:JSON.stringify(Object.fromEntries(f))});state.me=await api('/api/auth/me');app.innerHTML=layout(`<main class="page"><div class="center"><div class="card result-box"><div class="eyebrow">Registration complete</div><h2>Your Student ID</h2><div class="score">${esc(d.studentId)}</div><p class="muted">Save this ID. You can use it or your email to log in.</p><button class="btn orange" onclick="go('dashboard')">Continue to Dashboard</button></div></div></main>`)}catch(x){showToast(x.message)}}
async function logout(){await api('/api/auth/logout',{method:'POST'}).catch(()=>{});state.me=null;state.view='home';render()}
async function renderDashboard(){let exams=[],results=[];try{[exams,results]=await Promise.all([api('/api/exams'),api('/api/results')])}catch(x){showToast(x.message)}app.innerHTML=layout(`<main class="page"><div class="dashboard-head"><div><div class="eyebrow">Student dashboard</div><h1>${esc(state.me.user.fullName)}</h1><p class="muted">Student ID · <b>${esc(state.me.user.studentId)}</b></p></div></div><section class="grid grid-3">${exams.length?exams.map(examCard).join(''):`<div class="card empty">No active exams are available right now.</div>`}</section><div class="section-head"><div><div class="eyebrow">Performance</div><h2>My results</h2></div></div><div class="card">${results.length?`<div class="table-wrap"><table class="table"><thead><tr><th>Exam</th><th>Score</th><th>Percentage</th><th>Status</th><th>Date</th></tr></thead><tbody>${results.map(r=>`<tr><td>${esc(r.title)}</td><td>${r.score} / ${r.total_points}</td><td>${Number(r.percentage).toFixed(1)}%</td><td><span class="pill ${r.passed?'pass':'fail'}">${r.passed?'Passed':'Not passed'}</span></td><td>${fmtDate(r.created_at)}</td></tr>`).join('')}</tbody></table></div>`:`<div class="empty">Your completed exams will appear here.</div>`}</div></main>`)}
function examCard(e){return `<article class="card exam-card"><span class="pill ${e.status==='active'?'active':''}">${e.status}</span><h3>${esc(e.title)}</h3><p class="muted">${esc(e.description||'Finance assessment')}</p><div class="exam-meta"><span>${e.question_count} questions</span><span>·</span><span>${e.duration_minutes} min</span><span>·</span><span>Pass ${e.passing_percentage}%</span></div><button class="btn orange" onclick="startExam(${e.id})">Start Exam ↗</button></article>`}
async function startExam(id){
  try{
    clearInterval(state.timer);
    state.submitting=false;
    state.expired=false;
    state.answers={};
    state.questions=[];
    const d=await api(`/api/exams/${id}/start`);
    if(!d?.exam) throw new Error('Exam data could not be loaded');
    if(!Array.isArray(d.questions)) throw new Error('Exam questions could not be loaded');
    if(!d.attemptId) throw new Error('Exam attempt could not be created');
    state.exam=d.exam;
    state.questions=d.questions;
    state.attemptId=d.attemptId;
    state.startedAt=d.startedAt;
    state.view='exam';
    renderExam();
    startTimer();
  }catch(x){
    console.error('START EXAM ERROR:',x);
    showToast(x.message||'Unable to start exam');
  }
}
function renderExam(){app.innerHTML=layout(`<main class="page"><div class="center"><div class="exam-top"><div><div class="eyebrow">Active assessment</div><b>${esc(state.exam.title)}</b></div><div class="timer" id="timer">--:--</div></div><form onsubmit="submitExam(event)">${state.questions.map((q,i)=>`<section class="question"><div class="small-text muted">Question ${i+1} · ${q.points} point${q.points==1?'':'s'}</div><div class="question-title">${esc(q.question_text)}</div>${['A','B','C','D'].map(k=>`<label class="option"><input type="radio" name="q${q.id}" value="${k}" onchange="state.answers[${q.id}]='${k}'"> <b>${k}.</b> <span>${esc(q['option_'+k.toLowerCase()])}</span></label>`).join('')}</section>`).join('')}<div class="card"><div class="actions"><button class="btn orange">Submit Exam</button><button type="button" class="btn ghost" onclick="if(confirm('Leave the exam? Your in-progress attempt will remain until its timer expires.'))go('dashboard')">Leave</button></div></div></form></div></main>`)}
function startTimer(){
  clearInterval(state.timer);
  if(!state.exam||!state.startedAt){
    console.error('Timer data missing',state.exam,state.startedAt);
    return;
  }
  const raw=String(state.startedAt);
  const normalized=raw.includes('T')?raw:raw.replace(' ','T');
  const parsed=Date.parse(normalized.endsWith('Z')?normalized:`${normalized}Z`);
  const duration=Number(state.exam.duration_minutes);
  if(!Number.isFinite(parsed)||!Number.isFinite(duration)||duration<=0){
    console.error('Invalid timer values:',state.startedAt,state.exam.duration_minutes);
    const el=document.getElementById('timer');
    if(el)el.textContent='--:--';
    return;
  }
  const end=parsed+(duration*60000);
  const tick=()=>{
    if(state.view!=='exam'){
      clearInterval(state.timer);
      return;
    }
    const left=Math.max(0,end-Date.now());
    const minutes=Math.floor(left/60000);
    const seconds=Math.floor(left/1000)%60;
    const el=document.getElementById('timer');
    if(el)el.textContent=`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
    if(left<=0&&!state.submitting){
      clearInterval(state.timer);
      state.expired=true;
      submitExam(null,true);
    }
  };
  tick();
  state.timer=setInterval(tick,1000);
}
async function submitExam(e,expired=false){
  if(e) e.preventDefault();
  if(state.submitting) return;
  if(!state.attemptId){
    showToast('Exam attempt is missing');
    return;
  }
  if(!expired&&!confirm('Submit this exam now?')) return;
  state.submitting=true;
  clearInterval(state.timer);
  const answers=Object.entries(state.answers).map(([questionId,answer])=>({questionId:Number(questionId),answer}));
  try{
    const d=await api(`/api/attempts/${state.attemptId}/submit`,{method:'POST',body:JSON.stringify({answers})});
    if(!d?.result) throw new Error('The exam was submitted but no result was returned');
    state.lastResult=d.result;
    state.view='result';
    renderResult(d.result);
  }catch(x){
    console.error('SUBMIT EXAM ERROR:',x);
    state.submitting=false;
    showToast(x.message||'Unable to submit the exam');
    const btn=document.querySelector('button[type="submit"]');
    if(btn){btn.disabled=false;btn.textContent='Submit Exam';}
  }
}
function renderResult(r){app.innerHTML=layout(`<main class="page"><div class="center"><div class="card result-box"><div class="eyebrow">Assessment result</div><h1>${esc(r.examTitle)}</h1><div class="score">${Number(r.percentage).toFixed(1)}%</div><p>${r.score} / ${r.totalPoints} points</p><span class="pill ${r.passed?'pass':'fail'}">${r.passed?'Passed':'Not passed'}</span><div class="actions" style="justify-content:center;margin-top:25px"><button class="btn orange" onclick="go('dashboard')">Back to Dashboard</button></div></div></div></main>`)}
async function renderAdmin(){app.innerHTML=layout(`<div class="admin-layout"><aside class="sidebar"><button class="side-btn ${state.adminTab==='overview'?'active':''}" onclick="adminTab('overview')">Overview</button><button class="side-btn ${state.adminTab==='students'?'active':''}" onclick="adminTab('students')">Students</button><button class="side-btn ${state.adminTab==='exams'?'active':''}" onclick="adminTab('exams')">Exams</button><button class="side-btn ${state.adminTab==='results'?'active':''}" onclick="adminTab('results')">Results</button>${state.me.admin.role==='super_admin'?`<button class="side-btn ${state.adminTab==='admins'?'active':''}" onclick="adminTab('admins')">Admin Users</button>`:''}</aside><main class="admin-main" id="admin-main"></main></div>`);await loadAdminTab()}
function adminTab(t){state.adminTab=t;renderAdmin()}
async function loadAdminTab(){const el=document.getElementById('admin-main');if(state.adminTab==='overview')return adminOverview(el);if(state.adminTab==='students')return adminStudents(el);if(state.adminTab==='exams')return adminExams(el);if(state.adminTab==='results')return adminResults(el);if(state.adminTab==='admins')return adminAdmins(el)}
async function adminOverview(el){const d=await api('/api/admin/stats');el.innerHTML=`<div class="dashboard-head"><div><div class="eyebrow">Control center</div><h1>Overview</h1><p class="muted">Manage the assessment platform.</p></div></div><div class="kpis"><div class="card kpi"><div class="muted">Students</div><div class="num">${d.students}</div></div><div class="card kpi"><div class="muted">Exams</div><div class="num">${d.exams}</div></div><div class="card kpi"><div class="muted">Attempts</div><div class="num">${d.attempts}</div></div><div class="card kpi"><div class="muted">Avg. score</div><div class="num">${d.averagePercentage.toFixed(1)}%</div></div></div><div class="grid grid-2 admin-section"><div class="card"><div class="eyebrow">Pass rate</div><div class="score" style="font-size:48px">${d.passRate.toFixed(1)}%</div><p class="muted">Across completed attempts.</p></div><div class="card"><h3>Admin</h3><p class="muted">Signed in as <b>${esc(state.me.admin.username)}</b> · ${esc(state.me.admin.role)}</p><button class="btn ghost" onclick="adminTab('exams')">Manage exams →</button></div></div>`}
async function adminStudents(el){const rows=await api('/api/admin/students');el.innerHTML=`<div class="dashboard-head"><div><div class="eyebrow">People</div><h1>Students</h1></div><div class="toolbar"><input id="studentSearch" placeholder="Search students…" oninput="searchStudents()"></div></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Student ID</th><th>Name</th><th>Email</th><th>Status</th><th>Joined</th><th></th></tr></thead><tbody id="students-body">${studentRows(rows)}</tbody></table></div></div>`}
function studentRows(rows){return rows.map(r=>`<tr><td><b>${esc(r.student_id)}</b></td><td>${esc(r.full_name)}</td><td>${esc(r.email)}</td><td><span class="pill">${r.status}</span></td><td>${fmtDate(r.created_at)}</td><td><button class="btn small ghost" onclick="studentDetail(${r.id})">View</button></td></tr>`).join('')||`<tr><td colspan="6" class="empty">No students found.</td></tr>`}
let searchTimer;async function searchStudents(){clearTimeout(searchTimer);searchTimer=setTimeout(async()=>{const q=document.getElementById('studentSearch').value;const rows=await api('/api/admin/students?q='+encodeURIComponent(q));document.getElementById('students-body').innerHTML=studentRows(rows)},250)}
async function studentDetail(id){const d=await api(`/api/admin/students/${id}`);openModal(`<div class="modal-head"><div><div class="eyebrow">Student profile</div><h2>${esc(d.student.full_name)}</h2></div><button class="icon-btn" onclick="closeModal()">×</button></div><div class="grid grid-2"><div class="card"><b>Student ID</b><div style="font-size:24px;margin-top:8px">${esc(d.student.student_id)}</div><p>${esc(d.student.email)}</p><span class="pill">${d.student.status}</span><div class="actions" style="margin-top:15px"><button class="btn small ${d.student.status==='active'?'danger':'orange'}" onclick="toggleStudent(${id},'${d.student.status==='active'?'blocked':'active'}')">${d.student.status==='active'?'Block':'Activate'}</button></div></div><div class="card"><b>Exam results</b>${d.results.length?`<div class="stack" style="margin-top:12px">${d.results.map(r=>`<div class="statline"><span>${esc(r.title)}</span><span>${Number(r.percentage).toFixed(1)}%</span></div>`).join('')}</div>`:`<p class="muted">No results yet.</p>`}</div></div>`)}
async function toggleStudent(id,status){await api(`/api/admin/students/${id}`,{method:'PATCH',body:JSON.stringify({status})});closeModal();showToast('Student status updated');adminTab('students')}
async function adminExams(el){const rows=await api('/api/admin/exams');el.innerHTML=`<div class="dashboard-head"><div><div class="eyebrow">Assessment design</div><h1>Exams</h1></div><button class="btn orange" onclick="examForm()">+ New Exam</button></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Exam</th><th>Questions</th><th>Duration</th><th>Pass</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows.map(r=>`<tr><td><b>${esc(r.title)}</b><div class="small-text muted">${esc(r.description||'')}</div></td><td>${r.question_count}</td><td>${r.duration_minutes} min</td><td>${r.passing_percentage}%</td><td><span class="pill">${r.status}</span></td><td><div class="actions"><button class="btn small ghost" onclick="questionManager(${r.id},'${esc(r.title).replaceAll("'","&#39;")}')">Questions</button><button class="btn small ghost" onclick='examForm(${JSON.stringify(r).replace(/'/g,"&#39;")})'>Edit</button><button class="btn small danger" onclick="deleteExam(${r.id})">Delete</button></div></td></tr>`).join('')||`<tr><td colspan="6" class="empty">No exams.</td></tr>`}</tbody></table></div></div>`}
function examForm(exam=null){openModal(`<div class="modal-head"><div><div class="eyebrow">${exam?'Edit exam':'Create exam'}</div><h2>${exam?'Update assessment':'New assessment'}</h2></div><button class="icon-btn" onclick="closeModal()">×</button></div><form class="form" onsubmit="saveExam(event,${exam?.id||0})"><div class="field"><label>Title</label><input name="title" required value="${esc(exam?.title||'')}"></div><div class="field"><label>Description</label><textarea name="description" rows="3">${esc(exam?.description||'')}</textarea></div><div class="two-col"><div class="field"><label>Duration (minutes)</label><input name="durationMinutes" type="number" min="1" max="600" required value="${exam?.duration_minutes||30}"></div><div class="field"><label>Passing percentage</label><input name="passingPercentage" type="number" min="0" max="100" step="0.1" required value="${exam?.passing_percentage??50}"></div></div><div class="field"><label>Status</label><select name="status"><option value="active" ${exam?.status==='active'?'selected':''}>Active</option><option value="inactive" ${exam?.status!=='active'?'selected':''}>Inactive</option></select></div><button class="btn orange">Save Exam</button></form>`)}
async function saveExam(e,id){e.preventDefault();const data=Object.fromEntries(new FormData(e.target));try{await api(id?`/api/admin/exams/${id}`:'/api/admin/exams',{method:id?'PUT':'POST',body:JSON.stringify(data)});closeModal();showToast('Exam saved');adminTab('exams')}catch(x){showToast(x.message)}}
async function deleteExam(id){if(!confirm('Delete this exam and all its questions/results?'))return;try{await api(`/api/admin/exams/${id}`,{method:'DELETE'});showToast('Exam deleted');adminTab('exams')}catch(x){showToast(x.message)}}
async function questionManager(examId,title){const qs=await api(`/api/admin/exams/${examId}/questions`);openModal(`<div class="modal-head"><div><div class="eyebrow">Question bank</div><h2>${esc(title)}</h2></div><button class="icon-btn" onclick="closeModal()">×</button></div><div class="actions" style="margin-bottom:15px"><button class="btn orange" onclick="questionForm(${examId},null,'${esc(title).replaceAll("'","&#39;")}')">+ Add Question</button></div><div class="stack">${qs.map((q,i)=>`<div class="card"><div class="small-text muted">Question ${i+1} · ${q.points} point${q.points==1?'':'s'} · Correct answer ${q.correct_answer}</div><b>${esc(q.question_text)}</b><p class="small-text muted">A. ${esc(q.option_a)} · B. ${esc(q.option_b)} · C. ${esc(q.option_c)} · D. ${esc(q.option_d)}</p><div class="actions"><button class="btn small ghost" onclick='questionForm(${examId},${JSON.stringify(q).replace(/'/g,"&#39;")},"${esc(title).replaceAll("'","&#39;")}")'>Edit</button><button class="btn small danger" onclick="deleteQuestion(${q.id},${examId},'${esc(title).replaceAll("'","&#39;")}')">Delete</button></div></div>`).join('')||`<div class="empty">No questions yet.</div>`}</div>`)}
function questionForm(examId,q,title){openModal(`<div class="modal-head"><div><div class="eyebrow">${q?'Edit question':'Add question'}</div><h2>${esc(title)}</h2></div><button class="icon-btn" onclick="questionManager(${examId},'${esc(title).replaceAll("'","&#39;")}')">×</button></div><form class="form" onsubmit="saveQuestion(event,${examId},${q?.id||0},'${esc(title).replaceAll("'","&#39;")}')"><div class="field"><label>Question</label><textarea name="questionText" rows="4" required>${esc(q?.question_text||'')}</textarea></div><div class="two-col"><div class="field"><label>Option A</label><input name="optionA" required value="${esc(q?.option_a||'')}"></div><div class="field"><label>Option B</label><input name="optionB" required value="${esc(q?.option_b||'')}"></div><div class="field"><label>Option C</label><input name="optionC" required value="${esc(q?.option_c||'')}"></div><div class="field"><label>Option D</label><input name="optionD" required value="${esc(q?.option_d||'')}"></div></div><div class="two-col"><div class="field"><label>Correct answer</label><select name="correctAnswer">${['A','B','C','D'].map(x=>`<option ${q?.correct_answer===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Points</label><input name="points" type="number" min="0.1" step="0.1" value="${q?.points||1}"></div></div><div class="field"><label>Sort order</label><input name="sortOrder" type="number" value="${q?.sort_order||0}"></div><button class="btn orange">Save Question</button></form>`)}
async function saveQuestion(e,examId,id,title){e.preventDefault();const data=Object.fromEntries(new FormData(e.target));data.examId=examId;try{await api(id?`/api/admin/questions/${id}`:'/api/admin/questions',{method:id?'PUT':'POST',body:JSON.stringify(data)});await questionManager(examId,title);showToast('Question saved')}catch(x){showToast(x.message)}}
async function deleteQuestion(id,examId,title){if(!confirm('Delete this question?'))return;await api(`/api/admin/questions/${id}`,{method:'DELETE'});await questionManager(examId,title);showToast('Question deleted')}
async function adminResults(el){const rows=await api('/api/admin/results');el.innerHTML=`<div class="dashboard-head"><div><div class="eyebrow">Performance</div><h1>Results</h1></div><div class="toolbar"><input id="resultSearch" placeholder="Search results…" oninput="searchResults()"></div></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Student</th><th>Exam</th><th>Score</th><th>Percentage</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody id="results-body">${resultRows(rows)}</tbody></table></div></div>`}
function resultRows(rows){return rows.map(r=>`<tr><td><b>${esc(r.student_id)}</b><div class="small-text muted">${esc(r.full_name)}</div></td><td>${esc(r.title)}</td><td>${r.score}/${r.total_points}</td><td>${Number(r.percentage).toFixed(1)}%</td><td><span class="pill ${r.passed?'pass':'fail'}">${r.passed?'Passed':'Not passed'}</span></td><td>${fmtDate(r.created_at)}</td><td><button class="btn small ghost" onclick="resultDetail(${r.id})">View</button></td></tr>`).join('')||`<tr><td colspan="7" class="empty">No results.</td></tr>`}
let resultTimer;async function searchResults(){clearTimeout(resultTimer);resultTimer=setTimeout(async()=>{const q=document.getElementById('resultSearch').value;const rows=await api('/api/admin/results?q='+encodeURIComponent(q));document.getElementById('results-body').innerHTML=resultRows(rows)},250)}
async function resultDetail(id){const d=await api(`/api/admin/results/${id}`);openModal(`<div class="modal-head"><div><div class="eyebrow">Result detail</div><h2>${esc(d.result.title)}</h2><p class="muted">${esc(d.result.student_id)} · ${esc(d.result.full_name)}</p></div><button class="icon-btn" onclick="closeModal()">×</button></div><div class="grid grid-3"><div class="card"><b>Score</b><div class="score" style="font-size:35px">${Number(d.result.percentage).toFixed(1)}%</div></div><div class="card"><b>Points</b><p>${d.result.score} / ${d.result.total_points}</p></div><div class="card"><b>Status</b><p class="${d.result.passed?'success-text':'danger-text'}">${d.result.passed?'Passed':'Not passed'}</p></div></div><div class="stack" style="margin-top:16px">${d.answers.map((a,i)=>`<div class="card"><b>${i+1}. ${esc(a.question_text)}</b><p class="small-text">Selected: ${a.selected_answer||'No answer'} · Correct: ${a.correct_answer} · ${a.is_correct?'Correct':'Incorrect'}</p></div>`).join('')}</div>`)}
async function adminAdmins(el){const rows=await api('/api/admin/admins');el.innerHTML=`<div class="dashboard-head"><div><div class="eyebrow">Access control</div><h1>Admin users</h1></div><button class="btn orange" onclick="adminForm()">+ Add Admin</button></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Username</th><th>Role</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>${rows.map(r=>`<tr><td><b>${esc(r.username)}</b></td><td>${esc(r.role)}</td><td><span class="pill">${r.status}</span></td><td>${fmtDate(r.created_at)}</td><td>${r.id!==undefined?`<button class="btn small ghost" onclick="toggleAdmin(${r.id},'${r.status==='active'?'blocked':'active'}')">${r.status==='active'?'Block':'Activate'}</button>`:''}</td></tr>`).join('')}</tbody></table></div></div>`}
function adminForm(){openModal(`<div class="modal-head"><div><div class="eyebrow">Access control</div><h2>Add admin</h2></div><button class="icon-btn" onclick="closeModal()">×</button></div><form class="form" onsubmit="saveAdmin(event)"><div class="field"><label>Username</label><input name="username" pattern="[A-Za-z0-9._-]{3,80}" required></div><div class="field"><label>Password</label><input name="password" type="password" minlength="8" required></div><div class="field"><label>Role</label><select name="role"><option value="admin">Admin</option><option value="super_admin">Super admin</option></select></div><button class="btn orange">Create Admin</button></form>`)}
async function saveAdmin(e){e.preventDefault();try{await api('/api/admin/admins',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});closeModal();showToast('Admin created');adminTab('admins')}catch(x){showToast(x.message)}}
async function toggleAdmin(id,status){await api(`/api/admin/admins/${id}`,{method:'PATCH',body:JSON.stringify({status})});showToast('Admin status updated');adminTab('admins')}
function openModal(html){const d=document.createElement('div');d.id='modal';d.className='modal-backdrop';d.innerHTML=`<div class="modal">${html}</div>`;document.body.appendChild(d)}function closeModal(){document.getElementById('modal')?.remove()}
function go(v){state.view=v;if(v!=='exam')clearInterval(state.timer);render()}
window.go=go;window.adminLogin=adminLogin;window.studentLogin=studentLogin;window.studentRegister=studentRegister;window.logout=logout;window.startExam=startExam;window.submitExam=submitExam;window.adminTab=adminTab;window.searchStudents=searchStudents;window.studentDetail=studentDetail;window.toggleStudent=toggleStudent;window.examForm=examForm;window.saveExam=saveExam;window.deleteExam=deleteExam;window.questionManager=questionManager;window.questionForm=questionForm;window.saveQuestion=saveQuestion;window.deleteQuestion=deleteQuestion;window.searchResults=searchResults;window.resultDetail=resultDetail;window.adminForm=adminForm;window.saveAdmin=saveAdmin;window.toggleAdmin=toggleAdmin;window.closeModal=closeModal;
boot();
